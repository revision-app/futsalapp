{
  "name": "futsalapp",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:lan": "next dev --webpack --hostname 0.0.0.0",
    "dev:localdb": "node scripts/dev-localdb.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
